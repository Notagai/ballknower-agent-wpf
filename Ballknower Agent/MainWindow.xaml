<Window x:Class="Ballknower.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Title="Ballknower"
            WindowStyle="None"
            ResizeMode="NoResize"
            AllowsTransparency="True"
            Background="Transparent"
            ShowInTaskbar="False"
            Topmost="True"
            WindowState="Maximized">

    <Grid x:Name="ContentRoot"
              Background="Transparent">

        <!-- Static blurred desktop backdrop -->
        <Image x:Name="DesktopBackdrop"
                   Stretch="Fill"
                   IsHitTestVisible="False"/>

        <!-- Very subtle darkening over the blur -->
        <Border x:Name="BackdropOverlay"
                    Background="#12000000"
                    IsHitTestVisible="False"/>

        <!-- Conversation -->
        <Border x:Name="MessageArea"
                    Width="1400"
                    Height="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="Black"
                    CornerRadius="20"
                    Padding="25"
                    Visibility="Collapsed">

            <ScrollViewer x:Name="ChatScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">

                <StackPanel x:Name="MessagePanel"/>

            </ScrollViewer>
        </Border>

        <!-- Command autocomplete -->
        <Border x:Name="CommandSuggestions"
                    Panel.ZIndex="100"
                    Width="700"
                    MaxHeight="260"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="Black"
                    CornerRadius="18"
                    Padding="8"
                    Visibility="Collapsed">

            <ListBox x:Name="CommandSuggestionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="CommandSuggestionList_SelectionChanged"
                         MouseLeftButtonUp="CommandSuggestionList_MouseLeftButtonUp"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">

                        <Setter Property="Padding"
                                    Value="14,10"/>

                        <Setter Property="Margin"
                                    Value="0,2"/>

                        <Setter Property="Background"
                                    Value="Transparent"/>

                        <Setter Property="Foreground"
                                    Value="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=Foreground}"/>

                        <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">

                                    <Border x:Name="SuggestionItemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="12"
                                                Padding="{TemplateBinding Padding}">

                                        <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                                    </Border>

                                    <ControlTemplate.Triggers>

                                        <Trigger Property="IsMouseOver"
                                                     Value="True">
                                            <Setter TargetName="SuggestionItemBorder"
                                                        Property="Background"
                                                        Value="#22000000"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected"
                                                     Value="True">
                                            <Setter TargetName="SuggestionItemBorder"
                                                        Property="Background"
                                                        Value="#33000000"/>
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                           Text="{Binding Command}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="4,0,14,0"/>

                            <TextBlock Grid.Column="1"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           Opacity="0.65"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                        </Grid>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Border>

        <!-- Confetti easter egg overlay -->
        <Canvas x:Name="ConfettiCanvas"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Panel.ZIndex="1000"/>

        <!-- Input pill -->
        <Border x:Name="InputPill"
                    Width="700"
                    MinHeight="70"
                    MaxHeight="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="Black"
                    BorderThickness="0"
                    CornerRadius="35"
                    Padding="10,10,10,10">

            <Grid MinHeight="50">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ChatInput"
                         Grid.Column="0"
                         MinHeight="44"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="20"
                         Foreground="White"
                         CaretBrush="White"
                         Padding="14,8,16,6"
                         Margin="0,0,2,0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top"
                         VerticalContentAlignment="Top"
                         HorizontalContentAlignment="Stretch"
                         SnapsToDevicePixels="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         TextChanged="ChatInput_TextChanged"
                         PreviewKeyDown="ChatInput_PreviewKeyDown"/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Margin="8,0,2,0"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Right"
                        Background="White"
                        Foreground="Black"
                        BorderBrush="White"
                        BorderThickness="0"
                        FontSize="18"
                        FontWeight="SemiBold"
                        ToolTip="Send"
                        Click="SendButton_Click"
                        Content="➤">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SendButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="21">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,1,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SendButtonBorder" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SendButtonBorder" Property="Opacity" Value="0.72"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="SendButtonBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>