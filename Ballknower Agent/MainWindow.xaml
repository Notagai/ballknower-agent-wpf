<Window x:Class="Ballknower.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ballknower"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized">

    <Grid x:Name="ContentRoot"
          Background="Transparent">

        <!-- Static blurred desktop backdrop -->
        <Image x:Name="DesktopBackdrop"
               Stretch="Fill"
               IsHitTestVisible="False"/>

        <!-- Very subtle darkening over the blur -->
        <Border x:Name="BackdropOverlay"
                Background="#12000000"
                IsHitTestVisible="False"/>

        <!-- Conversation -->
        <Border x:Name="MessageArea"
                Width="700"
                Height="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Black"
                CornerRadius="20"
                Padding="25"
                Visibility="Collapsed">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="MessagePanel"/>

            </ScrollViewer>
        </Border>

        <!-- Input pill -->
        <Border x:Name="InputPill"
                Width="700"
                Height="70"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Black"
                CornerRadius="35">

            <Grid Height="70">

                <TextBox x:Name="ChatInput"
                         Width="650"
                         Height="44"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="20"
                         Foreground="White"
                         CaretBrush="White"
                         Padding="12,0,12,0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         TextWrapping="NoWrap"
                         AcceptsReturn="False"
                         PreviewKeyDown="ChatInput_PreviewKeyDown"/>

            </Grid>
        </Border>

    </Grid>
</Window>