<Window x:Class="Ballknower.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ballknower Settings" Width="700" Height="720"
        MinWidth="620" MinHeight="600"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF181818" Foreground="White"
        Closing="Window_Closing">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="UnsavedChangesText" Text="You have unsaved changes" Foreground="#FFFFC857" Visibility="Collapsed" Margin="0,0,0,10"/>
            <DockPanel>
                <TextBlock Text="Changes are saved only when you click Save." Foreground="White" Opacity="0.55" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="0,0,10,0" MinWidth="90"/>
                    <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" MinWidth="90"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <TabControl x:Name="SettingsTabs">
            <TabItem Header="AI &amp; Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="AI Provider" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProviderInput" SelectedValuePath="Content" SelectionChanged="ProviderInput_SelectionChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="Groq"/><ComboBoxItem Content="OpenRouter"/>
                    </ComboBox>
                    <TextBlock x:Name="ApiKeyLabel" Text="Groq API Key" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="ApiKeyInput" PasswordChanged="SettingsChanged" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Test Key" Click="TestKeyButton_Click" Padding="14,5"/>
                        <TextBlock x:Name="KeyTestStatus" Text="○ Not tested" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFBDBDBD"/>
                    </StackPanel>
                    <TextBlock Text="API keys are stored locally using Windows encryption." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock x:Name="ModelLabel" Text="Groq Model" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ModelInput" TextChanged="SettingsChanged" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Test Prompt" Click="TestPromptButton_Click" Padding="14,5"/>
                        <TextBlock x:Name="PromptTestStatus" Text="○ Not tested" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFBDBDBD"/>
                    </StackPanel>
                    <TextBlock Text="The prompt test sends a short request to the selected provider and model; usage may incur a small API charge." FontSize="12" Opacity="0.65" TextWrapping="Wrap"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Conversation">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <CheckBox x:Name="StreamingCheckBox" Content="Stream responses" Foreground="White" Margin="0,0,0,22" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    <TextBlock Text="Conversation Memory" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Controls approximately how much previous conversation is sent with each AI request." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="HistoryBudgetLabel" Text="2,000 tokens" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Slider x:Name="HistoryBudgetSlider" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="HistoryBudgetSlider_ValueChanged" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Lower token usage" Opacity="0.65" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="More conversation history" HorizontalAlignment="Right" Opacity="0.65" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="This is a history budget, not a provider rate limit. The current request, tools and AI response also use tokens." TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
                    <Button Content="Test Conversation Settings" Click="TestConversationButton_Click" HorizontalAlignment="Left" Margin="0,24,0,8" Padding="14,5"/>
                    <TextBlock x:Name="ConversationTestStatus" Text="○ Not tested" Foreground="#FFBDBDBD"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="Add or edit a slash command" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="Opening shortcut" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="OpeningShortcutInput" SelectedValuePath="Content" SelectionChanged="OpeningShortcutInput_SelectionChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="Alt+Win"/>
                        <ComboBoxItem Content="Ctrl+Win"/>
                        <ComboBoxItem Content="Shift+Win"/>
                    </ComboBox>
                    <TextBlock Text="Built-in commands" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="/help — Show command list&#10;/settings — Open settings&#10;/logs — Open error logs&#10;/clear — Clear conversation&#10;/confetti — Show confetti&#10;/see — Reveal desktop without blur&#10;/pin — Stay visible while switching apps&#10;/unpin — Hide when focus is lost" Foreground="#FFBDBDBD" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBox x:Name="CommandInput" ToolTip="Command name, e.g. notes" Margin="0,0,0,8" TextChanged="SettingsChanged"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathInput" Grid.Column="0" TextChanged="SettingsChanged"/>
                        <Button Grid.Column="1" Content="Browse" Click="BrowseButton_Click" Margin="10,0,0,0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AddShortcutButton" Content="Add Shortcut" Click="AddShortcutButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="CancelEditButton" Content="Cancel Edit" Click="CancelEditButton_Click" Visibility="Collapsed"/>
                        <Button Content="Test Shortcut" Click="TestShortcutButton_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ShortcutTestStatus" Text="○ Not tested" Foreground="#FFBDBDBD" Margin="0,0,0,12"/>
                    <StackPanel x:Name="ShortcutList" Margin="0,0,0,20"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Data &amp; Settings">
                <StackPanel Margin="18">
                    <TextBlock Text="Import or export your settings as JSON." TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Import Settings" Click="ImportButton_Click" Margin="0,0,10,0"/>
                        <Button Content="Export Settings" Click="ExportButton_Click"/>
                    </StackPanel>
                    <Button Content="Test Settings Data" Click="TestDataButton_Click" HorizontalAlignment="Left" Margin="0,24,0,8" Padding="14,5"/>
                    <TextBlock x:Name="DataTestStatus" Text="○ Not tested" Foreground="#FFBDBDBD"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>