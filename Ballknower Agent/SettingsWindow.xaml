<Window x:Class="Ballknower.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ballknower Settings" Width="700" Height="720"
        MinWidth="620" MinHeight="600"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF181818" Foreground="White"
        Closing="Window_Closing">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="UnsavedChangesText" Text="You have unsaved changes" Foreground="#FFFFC857" Visibility="Collapsed" Margin="0,0,0,10"/>
            <DockPanel>
                <TextBlock Text="Changes are saved only when you click Save." Foreground="White" Opacity="0.55" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Margin="0,0,10,0" MinWidth="90"/>
                    <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" MinWidth="90"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
        <TabControl x:Name="SettingsTabs">
            <TabItem Header="AI &amp; Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="AI Provider" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ProviderInput" SelectedValuePath="Content" SelectionChanged="ProviderInput_SelectionChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="Groq"/><ComboBoxItem Content="OpenRouter"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Gemini"/>
                    </ComboBox>
                    <TextBlock Text="Search Provider" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="SearchProviderInput" SelectedValuePath="Content" SelectionChanged="SearchProviderInput_SelectionChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="DuckDuckGo"/>
                        <ComboBoxItem Content="Bing"/>
                    </ComboBox>
                    <TextBlock Text="Choose which public search engine Ballknower uses for the web_search tool. No search API key is required." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock x:Name="ApiKeyLabel" Text="Groq API Key" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="ApiKeyInput" PasswordChanged="SettingsChanged" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Test Key" Click="TestKeyButton_Click" Padding="14,5"/>
                        <TextBlock x:Name="KeyTestStatus" Text="○ Not tested" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFBDBDBD"/>
                    </StackPanel>
                    <TextBlock Text="API keys are stored locally using Windows encryption." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock x:Name="ModelLabel" Text="Groq Model" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="ModelInput" TextChanged="SettingsChanged" Margin="0,0,0,8"/>
                    <Button x:Name="FetchGeminiModelsButton" Content="Fetch Available Gemini Models" Click="FetchGeminiModelsButton_Click" HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,8" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Test Prompt" Click="TestPromptButton_Click" Padding="14,5"/>
                        <TextBlock x:Name="PromptTestStatus" Text="○ Not tested" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFBDBDBD"/>
                    </StackPanel>
                    <TextBlock Text="The prompt test sends a short request to the selected provider and model; usage may incur a small API charge." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock Text="Saved AI Presets" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Save a provider, model, and API key together. API keys are encrypted with Windows DPAPI and are never written to GitHub." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="PresetNameInput" MinWidth="240" Margin="0,0,8,0" ToolTip="Preset name"/>
                        <Button Content="Save Current as Preset" Click="SavePresetButton_Click" Padding="14,5"/>
                    </StackPanel>
                    <StackPanel x:Name="PresetList" Margin="0,0,0,18"/>
                    <TextBlock Text="Advanced" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="JailbreakCheckBox" Content="Jailbreak" Foreground="White" Margin="0,0,0,8" Checked="JailbreakCheckBox_Changed" Unchecked="JailbreakCheckBox_Changed"/>
                    <StackPanel x:Name="JailbreakPromptPanel" Visibility="Collapsed">
                        <TextBlock Text="Jailbreak prompt" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="JailbreakPromptInput" MinHeight="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="SettingsChanged"/>
                        <TextBlock Text="When enabled, the prompt is prepended to the first user message after launch. AI tool access is restricted to web search only; local file and other AI tools are blocked by the app." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Conversation">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <CheckBox x:Name="StreamingCheckBox" Content="Stream responses" Foreground="White" Margin="0,0,0,22" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    <TextBlock Text="Conversation Memory" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Controls approximately how much previous conversation is sent with each AI request." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="HistoryBudgetLabel" Text="2,000 tokens" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Slider x:Name="HistoryBudgetSlider" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="HistoryBudgetSlider_ValueChanged" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Lower token usage" Opacity="0.65" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="More conversation history" HorizontalAlignment="Right" Opacity="0.65" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="This is a history budget, not a provider rate limit. The current request, tools and AI response also use tokens." TextWrapping="Wrap" Opacity="0.65" FontSize="12"/>
                    <Button Content="Test Conversation Settings" Click="TestConversationButton_Click" HorizontalAlignment="Left" Margin="0,24,0,8" Padding="14,5"/>
                    <TextBlock x:Name="ConversationTestStatus" Text="○ Not tested" Foreground="#FFBDBDBD"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="Command Shortcuts" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Optional command shortcuts for launching local executables. These are separate from Ballknower's fixed voice activation shortcuts." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Command" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="CommandInput" Margin="0,0,0,10"/>
                    <TextBlock Text="Executable" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PathInput" Grid.Column="0" Margin="0,0,10,0"/>
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse" Click="BrowseButton_Click" Padding="14,5"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="AddShortcutButton" Content="Add Shortcut" Click="AddShortcutButton_Click" Padding="14,5" Margin="0,0,10,0"/>
                        <Button x:Name="CancelEditButton" Content="Cancel Edit" Click="CancelEditButton_Click" Padding="14,5" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button Content="Test Shortcut" Click="TestShortcutButton_Click" HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ShortcutTestStatus" Text="○ Not tested" Foreground="#FFBDBDBD" Margin="0,0,0,16"/>
                    <TextBlock Text="Saved Shortcuts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel x:Name="ShortcutList"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Speech">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="Speech" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Voice input uses the Microsoft Windows speech recognizer. Choose ElevenLabs API speech or the built-in Microsoft Windows TTS engine." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <TextBlock Text="Output" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SpeechOutputEnabledCheckBox" Content="Enable voice output" Margin="0,0,0,12" Checked="SpeechSettingChanged" Unchecked="SpeechSettingChanged"/>
                    <TextBlock Text="Output Provider" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SpeechProviderInput" SelectedValuePath="Content" SelectionChanged="SpeechProviderInput_SelectionChanged" Margin="0,0,0,12">
                        <ComboBoxItem Content="ElevenLabs"/><ComboBoxItem Content="Microsoft"/>
                    </ComboBox>
                    <StackPanel x:Name="ElevenLabsSettingsPanel">
                    <TextBlock Text="ElevenLabs API Key" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="SpeechApiKeyInput" PasswordChanged="SpeechSettingChanged" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Test Key" Click="TestSpeechKeyButton_Click" Padding="14,5"/>
                        <TextBlock x:Name="SpeechKeyStatus" Text="○ Not tested" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFBDBDBD"/>
                    </StackPanel>
                    <TextBlock Text="Voice" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="SpeechVoiceInput" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SpeechSettingChanged"/>
                        <Button Grid.Column="1" Content="Fetch Voices" Click="FetchSpeechVoicesButton_Click" Margin="10,0,0,0" Padding="14,5"/>
                    </Grid>
                    <TextBlock Text="Voice ID (manual override)" FontSize="12" Opacity="0.65" Margin="0,0,0,6"/>
                    <TextBox x:Name="SpeechVoiceIdInput" TextChanged="SpeechSettingChanged" Margin="0,0,0,12"/>
                    <TextBlock Text="Model" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="SpeechModelInput" Grid.Column="0" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="SpeechSettingChanged"/>
                        <Button Grid.Column="1" Content="Fetch Models" Click="FetchSpeechModelsButton_Click" Margin="10,0,0,0" Padding="14,5"/>
                    </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Test Voice" Click="TestSpeechButton_Click" Padding="14,5"/>
                        <TextBlock x:Name="SpeechTestStatus" Text="○ Not tested" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FFBDBDBD"/>
                    </StackPanel>
                    <TextBlock Text="Speaker" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="SpeechOutputDeviceInput" SelectionChanged="SpeechSettingChanged" Margin="0,0,0,12"/>
                    <Button Content="Refresh Speakers" Click="RefreshSpeechOutputDevicesButton_Click" HorizontalAlignment="Left" Padding="14,5" Margin="0,0,0,16"/>
                    <TextBlock Text="Volume" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Slider x:Name="SpeechVolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="SpeechVolumeSlider_ValueChanged" Margin="0,0,0,4"/>
                    <TextBlock x:Name="SpeechVolumeLabel" Text="100%" Opacity="0.65" Margin="0,0,0,18"/>
                    <TextBlock Text="Sound Effects" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="SpeechEffectsEnabledCheckBox" Content="Enable speech sound effects" Margin="0,0,0,8" Checked="SpeechSettingChanged" Unchecked="SpeechSettingChanged"/>
                    <CheckBox x:Name="SpeechStartupEffectCheckBox" Content="Startup / activation sound" Margin="0,0,0,8" Checked="SpeechSettingChanged" Unchecked="SpeechSettingChanged"/>
                    <CheckBox x:Name="SpeechListeningEffectCheckBox" Content="Listening sound" Margin="0,0,0,8" Checked="SpeechSettingChanged" Unchecked="SpeechSettingChanged"/>
                    <CheckBox x:Name="SpeechErrorEffectCheckBox" Content="Error sound" Margin="0,0,0,8" Checked="SpeechSettingChanged" Unchecked="SpeechSettingChanged"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Google Drive">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="Google Drive" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Connect Ballknower to one Google Drive account. Authentication is started only when you click Connect." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Status" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="GoogleDriveStatusText" Text="○ Not connected" Foreground="#FFBDBDBD" Margin="0,0,0,4"/>
                    <TextBlock x:Name="GoogleDriveAccountText" Text="" Foreground="#FFBDBDBD" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="GoogleDriveConnectButton" Content="Connect Google Drive" Click="GoogleDriveConnectButton_Click" Padding="14,5" Margin="0,0,10,0"/>
                        <Button x:Name="GoogleDriveTestButton" Content="Test Connection" Click="GoogleDriveTestButton_Click" Padding="14,5" Margin="0,0,10,0"/>
                        <Button x:Name="GoogleDriveDisconnectButton" Content="Disconnect" Click="GoogleDriveDisconnectButton_Click" Padding="14,5"/>
                    </StackPanel>
                    <TextBlock x:Name="GoogleDriveErrorText" Foreground="#FFFF7B72" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Text="Your OAuth token is stored locally using Windows encryption. The OAuth client JSON should remain on this PC and should not be committed to GitHub." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Style">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Customize Ballknower's light/dark surfaces, fonts, and visual effects." Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock Text="Preset" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="StylePresetInput" SelectedValuePath="Content" SelectionChanged="StylePresetInput_SelectionChanged" Margin="0,0,0,14">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Blue"/>
                        <ComboBoxItem Content="Purple"/>
                        <ComboBoxItem Content="Green"/>
                        <ComboBoxItem Content="Sunset"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    <TextBlock Text="Theme editing" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <RadioButton x:Name="UnifiedThemeRadio" Content="Unified palette" IsChecked="True" GroupName="ThemeMode" Checked="ThemeMode_Changed" Margin="0,0,18,0"/>
                        <RadioButton x:Name="SeparateThemeRadio" Content="Separate Light / Dark" GroupName="ThemeMode" Checked="ThemeMode_Changed"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Light background" FontWeight="SemiBold"/>
                            <TextBox x:Name="LightBackgroundInput" TextChanged="StyleColorChanged" Margin="0,4,0,8"/>
                            <TextBlock Text="Light text" FontWeight="SemiBold"/>
                            <TextBox x:Name="LightForegroundInput" TextChanged="StyleColorChanged" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Dark background" FontWeight="SemiBold"/>
                            <TextBox x:Name="DarkBackgroundInput" TextChanged="StyleColorChanged" Margin="0,4,0,8"/>
                            <TextBlock Text="Dark text" FontWeight="SemiBold"/>
                            <TextBox x:Name="DarkForegroundInput" TextChanged="StyleColorChanged" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Font" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="StyleFontInput" SelectedValuePath="Content" SelectionChanged="StyleFontInput_SelectionChanged" Margin="0,0,0,16">
                        <ComboBoxItem Content="Segoe UI"/><ComboBoxItem Content="Aptos"/><ComboBoxItem Content="Calibri"/><ComboBoxItem Content="Consolas"/><ComboBoxItem Content="Cascadia Code"/><ComboBoxItem Content="Trebuchet MS"/><ComboBoxItem Content="Georgia"/>
                    </ComboBox>
                    <TextBlock Text="Effects" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <CheckBox x:Name="AnimatedEffectsCheckBox" Content="Animated effects" Margin="0,0,0,8" Checked="StyleOptionChanged" Unchecked="StyleOptionChanged"/>
                    <CheckBox x:Name="RainbowBorderCheckBox" Content="Animated rainbow outline" Margin="0,0,0,8" Checked="StyleOptionChanged" Unchecked="StyleOptionChanged"/>
                    <CheckBox x:Name="GlowEffectCheckBox" Content="Soft glow on panels" Margin="0,0,0,8" Checked="StyleOptionChanged" Unchecked="StyleOptionChanged"/>
                    <TextBlock Text="Color values accept #RRGGBB or #AARRGGBB. Presets are a starting point; choose Separate Light / Dark to fine-tune each side independently." FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Data &amp; Settings">
                <StackPanel Margin="18">
                    <TextBlock Text="Import or export your settings as JSON." TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Import Settings" Click="ImportButton_Click" Margin="0,0,10,0"/>
                        <Button Content="Export Settings" Click="ExportButton_Click"/>
                    </StackPanel>
                    <Button Content="Test Settings Data" Click="TestDataButton_Click" HorizontalAlignment="Left" Margin="0,24,0,8" Padding="14,5"/>
                    <TextBlock x:Name="DataTestStatus" Text="○ Not tested" Foreground="#FFBDBDBD"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>